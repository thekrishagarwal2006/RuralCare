# RuralCare Environment Configuration

# Application
APP_NAME=RuralCare
ENVIRONMENT=development
DEBUG=True

# Backend Server
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL / SQLite fallback)
# For local SQLite development fallback: sqlite:///./ruralcare.db
# For PostgreSQL: postgresql://ruralcare_user:ruralcare_password@localhost:5432/ruralcare
DATABASE_URL=sqlite:///./ruralcare.db

# Redis Configuration (Optional in-memory fallback enabled if offline)
REDIS_URL=redis://localhost:6379/0

# JWT Security
JWT_SECRET=ruralcare_super_secret_jwt_key_2026_academic_project
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Map / Routing APIs
OSRM_SERVER_URL=http://router.project-osrm.org
